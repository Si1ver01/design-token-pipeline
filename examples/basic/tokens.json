{
  "color": {
    "$type": "color",
    "brand": {
      "primary": {
        "$value": "#2563eb",
        "$description": "Основной цвет бренда"
      },
      "focus": {
        "$value": "{color.brand.primary}",
        "$description": "Цвет focus ring"
      }
    }
  },
  "fontFamily": {
    "$type": "fontFamily",
    "sans": {
      "$value": "Inter, system-ui"
    }
  },
  "fontWeight": {
    "$type": "fontWeight",
